digraph ER {
graph [compound=true, rankdir=TB, newrank=true, nodesep=0.22, ranksep=0.42, fontname="Helvetica", fontsize=22, labelloc=t, label="MarketLab — Sellers", pad=0.3];
node [fontname="Helvetica", fontsize=11, color="#222222", fontcolor="#111111"];
edge [color="#333333", arrowsize=0.8, fontname="Helvetica", fontsize=9];
