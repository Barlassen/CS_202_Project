digraph ER {
graph [compound=true, rankdir=TB, newrank=true, nodesep=0.22, ranksep=0.42, fontname="Helvetica", fontsize=22, labelloc=t, label="Ternary relationship Stocks and its aggregation", pad=0.3];
node [fontname="Helvetica", fontsize=11, color="#222222", fontcolor="#111111"];
edge [color="#333333", arrowsize=0.8, fontname="Helvetica", fontsize=9];
E_order_lines [shape=box, penwidth=3, label="Order_Lines"];
P__order_lines__line_no [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label=<<U>line_no</U>>];
P__order_lines__line_no -> E_order_lines [dir=none];
A__order_lines__quantity [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label="quantity"];
A__order_lines__quantity -> E_order_lines [dir=none];
A__order_lines__unit_price_cents [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label="unit_price_cents"];
A__order_lines__unit_price_cents -> E_order_lines [dir=none];
E_stock_batches [shape=box, penwidth=1, label="Stock_Batches"];
A__stock_batches__batch_id [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label=<<U>batch_id</U>>];
A__stock_batches__batch_id -> E_stock_batches [dir=none];
A__stock_batches__received_at [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label="received_at"];
A__stock_batches__received_at -> E_stock_batches [dir=none];
A__stock_batches__quantity [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label="quantity"];
A__stock_batches__quantity -> E_stock_batches [dir=none];
subgraph cluster_agg { style=dashed; color="#222222"; penwidth=1.4; margin=14; label="Aggregation: Stocks"; fontsize=12; labeljust=l;
E_seller_organizations [shape=box, penwidth=1, label="Seller_Organizations"];
A__seller_organizations__seller_id [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label=<<U>seller_id</U>>];
A__seller_organizations__seller_id -> E_seller_organizations [dir=none];
A__seller_organizations__name [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label="name"];
A__seller_organizations__name -> E_seller_organizations [dir=none];
E_variants [shape=box, penwidth=1, label="Variants"];
A__variants__variant_id [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label=<<U>variant_id</U>>];
A__variants__variant_id -> E_variants [dir=none];
A__variants__sku [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label="sku"];
A__variants__sku -> E_variants [dir=none];
A__variants__variant_name [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label="variant_name"];
A__variants__variant_name -> E_variants [dir=none];
E_warehouses [shape=box, penwidth=1, label="Warehouses"];
A__warehouses__warehouse_id [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label=<<U>warehouse_id</U>>];
A__warehouses__warehouse_id -> E_warehouses [dir=none];
A__warehouses__name [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label="name"];
A__warehouses__name -> E_warehouses [dir=none];
R94 [shape=diamond, penwidth=1, margin="0.02,0.02", label="Stocks"];
RA94__available_qty [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label="available_qty"];
RA94__available_qty -> R94 [dir=none];
RA94__reorder_point [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label="reorder_point"];
RA94__reorder_point -> R94 [dir=none];
E_seller_organizations -> R94 [dir=none];
R94 -> E_variants [dir=none];
R94 -> E_warehouses [dir=none];
}
R44 [shape=diamond, penwidth=1, margin="0.02,0.02", label="Batch_Of"];
E_stock_batches -> R44 [dir=forward, arrowhead=normal, penwidth=3];
R44 -> R94 [dir=none, lhead=cluster_agg, penwidth=1];
R96 [shape=diamond, penwidth=1, margin="0.02,0.02", label="Reserves"];
RA96__quantity [shape=ellipse, fontsize=9, margin="0.04,0.02", height=0.3, label="quantity"];
RA96__quantity -> R96 [dir=none];
E_order_lines -> R96 [dir=none, penwidth=3];
R96 -> R94 [dir=none, lhead=cluster_agg, penwidth=1];
}
